---
import Base from '../layouts/Base.astro';import H from '../../data/hot.json';import S from '../data/scenarios.json';import {SITE} from '../site.config.mjs';
const N=Object.fromEntries(S.map(s=>[s.slug,s.name]));
const t=new Date(H.generatedAt).toLocaleString('zh-CN',{timeZone:'Asia/Shanghai'});
const jsonld=[{"@context":"https://schema.org","@type":"ItemList",name:'AI 新工具热榜',url:SITE.url+'/hot/',dateModified:H.generatedAt,itemListElement:H.items.slice(0,50).map((i,k)=>({"@type":"ListItem",position:k+1,name:i.name,url:i.url,description:i.intro}))}];
---
<Base title="AI 新工具热榜（每6小时更新）" description={`实时 AI 新工具热榜，汇总 GitHub、Hacker News、Hugging Face 热度，附中文简介与场景分类。更新于 ${t}（北京时间）。`} jsonld={jsonld}>
<h1>🔥 AI 热榜</h1><p class="muted">更新于 {t}（北京时间）· 共 {H.count} 条 · 评分=源内标准化热度×权重×7天新鲜度衰减{H.errors.length? ` · 备注：${H.errors.join('；')}`:''}</p>
<p>按场景浏览：{S.map(s=><a class="tag" href={`/s/${s.slug}/`}>{s.name}</a>)}</p>
<div style="overflow-x:auto"><table><thead><tr><th>#</th><th>热度</th><th>来源</th><th>名称</th><th>指标</th></tr></thead><tbody>{H.items.map((i,k)=><tr><td>{k+1}</td><td><b>{i.score}</b></td><td><span class="tag">{i.source}</span></td><td><a href={i.url} target="_blank" rel="nofollow noopener">{i.name}</a> {i.scenario&&<a class="tag" href={`/s/${i.scenario}/`}>{N[i.scenario]}</a>}{i.intro?<div>{i.intro}</div>:i.desc&&<div class="muted">{i.desc}</div>}</td><td class="muted">{i.metric} {i.metricLabel}</td></tr>)}</tbody></table></div></Base>
